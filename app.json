{
  "expo": {
    "name": "LexiLeap",
    "slug": "lexileap",
    "scheme": "lexileap",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexileap.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lexileap.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF6E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E9"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "LexiLeap listens while your child says a word out loud so it can tell them how they did. Audio is not stored.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LexiLeap listens while your child says a word out loud so it can tell them how they did. Audio is not stored.",
          "speechRecognitionPermission": "LexiLeap uses speech recognition to check the words your child reads out loud.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "If a parent turns on the Focus helper, LexiLeap briefly looks for your child's face during activities to notice when they are tired or distracted. Photos are checked on the device and deleted straight away.",
          "microphonePermission": "LexiLeap listens while your child says a word out loud so it can tell them how they did. Audio is not stored.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
